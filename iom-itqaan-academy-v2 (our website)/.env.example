NODE_ENV=production
ACADEMY_ENV=staging
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=replace_with_dedicated_academy_staging_database
DB_USER=replace_with_dedicated_academy_staging_user
