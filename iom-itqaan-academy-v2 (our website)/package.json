{
  "name": "iom-academy-management",
  "version": "0.3.0-staging.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc && npx tsc -p web/tsconfig.json --noEmit && npx vite build",
    "build:hostinger": "npm ci --include=dev && npm run build && npm prune --omit=dev",
    "dev:web": "vite",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:mysql": "npm run build && node --test --test-concurrency=1 dist/tests/mysql.integration.js",
    "test:upgrade": "npm run build && node tools/test-upgrade.mjs",
    "migrate": "node dist/src/cli.js migrate",
    "bootstrap": "node dist/src/cli.js bootstrap",
    "alerts": "node dist/src/cli.js alerts",
    "verify:baseline": "python tools/verify_baseline.py"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "^3.15.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
